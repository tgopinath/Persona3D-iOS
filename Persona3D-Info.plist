<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: the app's background colour only (HIG: a launch screen is not a splash screen).
	     ContentView then shows the app icon and a spinner until the page has loaded. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Persona3D uses the camera only when you choose to take reference photos for a character.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Persona3D opens your photo library only when you choose photos for a character.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Persona3D saves exported renders to your photo library only when you ask it to.</string>
</dict>
</plist>
